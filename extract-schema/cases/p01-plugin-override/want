{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"additionalProperties": true,
	"properties": {
		"at": {
			"format": "date-time",
			"type": "string"
		},
		"price": {
			"description": "money as '123USD'",
			"pattern": "^[0-9]+(USD|EUR)$",
			"type": "string"
		}
	},
	"required": [
		"at",
		"price"
	],
	"type": "object"
}
