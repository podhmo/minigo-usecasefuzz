{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"additionalProperties": true,
	"properties": {
		"level": {
			"maximum": 10,
			"minimum": 0,
			"type": "integer"
		},
		"pat": {
			"pattern": "^[a-z]+$",
			"type": "string"
		},
		"re": {
			"format": "int64",
			"type": "integer"
		},
		"req": {
			"minimum": 1,
			"type": "integer"
		}
	},
	"required": [
		"level",
		"pat",
		"re"
	],
	"type": "object"
}
