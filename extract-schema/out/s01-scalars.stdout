		},
		"i64": {
			"type": "integer"
		},
		"i8": {
			"type": "integer"
		},
		"r": {
			"type": "integer"
		},
		"s": {
			"type": "string"
		},
		"u": {
			"minimum": 0,
			"type": "integer"
		},
		"u16": {
			"minimum": 0,
			"type": "integer"
		},
		"u32": {
			"minimum": 0,
