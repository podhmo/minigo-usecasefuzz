		},
		"u64": {
			"minimum": 0,
			"type": "integer"
		},
		"u8": {
			"minimum": 0,
			"type": "integer"
		},
		"up": {
			"minimum": 0,
			"type": "integer"
		}
	},
	"required": [
		"any",
		"b",
		"by",
		"c128",
		"c64",
