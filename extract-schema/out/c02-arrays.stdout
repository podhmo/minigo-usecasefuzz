{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"additionalProperties": true,
	"properties": {
		"board": {
			"items": {
				"items": {
					"type": "string"
				},
				"type": "array"
			},
			"type": "array"
		},
		"rgb": {
			"items": {
				"type": "integer"
			},
			"type": "array"
		},
		"skip": {
			"items": {
				"minimum": 0,
				"type": "integer"
			},
			"type": "array"
		}
	},
	"required": [
		"board",
		"rgb",
		"skip"
	],
	"type": "object"
}
